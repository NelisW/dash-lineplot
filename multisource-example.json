      {
        "Variable": "Height",
        "Value": 300
      },
      {
        "Variable": "xLabel",
        "Value": "Time [s]",
        "Format": ".3f"
      },
      {
        "Variable": "xValue",
        "Value": "t"
      },
      {
        "Variable": "commonX",
        "Value": true
      },
      {
        "Variable": "GraphTop",
        "Value": "### Summary\n\nThe sheet's `xValue` is `t`, which source A uses. The source B and C rows name their own time column in their `xValue` cell, beside the `Datafile` cell that names their file."
      },
      {
        "Variable": "LegendX",
        "Value": 0.5
      },
      {
        "Variable": "Title",
        "Value": "value1 from three sources"
