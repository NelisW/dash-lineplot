      },
      {
        "Variable": "yValue",
        "Value": "value1",
        "Datafile": "data/multisource-a.json",
        "LineLabel": "A: t, 0.1 s",
        "Mode": "markers+lines",
        "MarkerOpacity": 0
      },
      {
        "Variable": "yValue",
        "Value": "value1",
        "Datafile": "data/multisource-b.json",
        "xValue": "time",
