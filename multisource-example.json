{
  "header": {
    "Pagetitle": "Multi-source demonstration",
    "PageTop": "# Several data sources on one graph\n\nEach graph plots the same quantity from three files. The files name their time column differently (`t`, `time`, `CurrentSimTime`) and sample on different grids; each line is drawn from its own file at its own samples, nothing resampled.",
    "PageBottom": "",
    "Datafile": "none",
    "Density": "compact",
    "LegendTransparency": 0.7,
    "LegendOrientation": "h",
    "LegendX": 0,
    "LegendY": 0
  },
